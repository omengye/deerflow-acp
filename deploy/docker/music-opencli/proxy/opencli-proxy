#!/opt/deerflow-skill-python/bin/python
"""OpenCLI argv proxy. Long-lived bridge credentials stay in a private file."""
import json
import os
from pathlib import Path
import signal
import sys
import time
import urllib.error
import urllib.request
import uuid

CONFIG = Path('/var/lib/deerflow/user-data/private/host-tools/opencli.json')
TERMINAL = {'completed', 'failed', 'cancelled', 'timed_out', 'output_limit', 'unknown'}


class BridgeError(Exception):
    pass


def request(config, method, path, value=None):
    data = json.dumps(value, ensure_ascii=False).encode() if value is not None else None
    req = urllib.request.Request(config['url'].rstrip('/') + path, data=data, method=method,
                                 headers={'Authorization': 'Bearer ' + config['token'],
                                          'Content-Type': 'application/json'})
    # Do not forward private bridge credentials through an ambient HTTP proxy.
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(req, timeout=3) as response:
            raw = response.read(2 * 1024 * 1024 + 1)
        if len(raw) > 2 * 1024 * 1024:
            raise BridgeError('bridge_response_too_large')
        result = json.loads(raw)
        if not isinstance(result, dict):
            raise BridgeError('invalid_bridge_response')
        return result
    except urllib.error.HTTPError as error:
        # Error bodies are not necessary and may include remote/private values.
        raise BridgeError('bridge_http_' + str(error.code)) from None
    except (urllib.error.URLError, TimeoutError, OSError, ValueError):
        raise BridgeError('bridge_connection_or_response_failed') from None


def invoke(argv, config_path=CONFIG):
    interrupted = False
    def cancel_signal(*_):
        nonlocal interrupted
        interrupted = True
    for name in ('SIGTERM', 'SIGINT'):
        signal.signal(getattr(signal, name), cancel_signal)
    job_id = None
    completed = False
    reason = None
    key = uuid.uuid4().hex
    try:
        path = Path(config_path)
        if os.name != 'nt' and path.stat().st_mode & 0o077:
            raise BridgeError('proxy_configuration_not_private')
        config = json.loads(path.read_text())
        if not isinstance(config.get('token'), str) or len(config['token']) < 32:
            raise BridgeError('proxy_configuration_invalid')
        timeout = config.get('timeout_seconds', 70)
        budget = config.get('client_timeout_seconds', 85)
        if not 1 <= timeout <= 180 or not timeout + 5 <= budget <= 210:
            raise BridgeError('proxy_deadline_invalid')
        deadline = time.monotonic() + budget
        payload = {'idempotency_key': key, 'argv': argv, 'timeout_seconds': timeout}
        # A lost submission is retried only with this exact durable key/payload.
        try:
            result = request(config, 'POST', '/v1/opencli/jobs', payload)
        except BridgeError:
            result = request(config, 'POST', '/v1/opencli/jobs', payload)
        job_id = result.get('id')
        if not isinstance(job_id, str) or len(job_id) != 32 or any(c not in '0123456789abcdef' for c in job_id):
            raise BridgeError('invalid_job_identity')
        while result.get('state') not in TERMINAL:
            if interrupted:
                reason = 'proxy_interrupted'
                break
            if time.monotonic() >= deadline:
                reason = 'proxy_deadline'
                break
            time.sleep(0.12)
            result = request(config, 'GET', '/v1/opencli/jobs/' + job_id)
        if reason:
            result = request(config, 'DELETE', '/v1/opencli/jobs/' + job_id)
            until = time.monotonic() + 4
            while result.get('state') not in TERMINAL and time.monotonic() < until:
                time.sleep(0.1)
                result = request(config, 'GET', '/v1/opencli/jobs/' + job_id)
        if result.get('state') not in TERMINAL or result.get('termination_confirmed') is not True:
            raise BridgeError(reason or 'host_state_unknown')
        completed = True
        sys.stdout.write(result.get('stdout', ''))
        sys.stderr.write(result.get('stderr', ''))
        state = result.get('state')
        if state not in ('completed', 'failed'):
            sys.stderr.write('\n' + json.dumps({'bridge_job': job_id, 'host_state': state,
                                                'host_termination_confirmed': True}) + '\n')
            return 124 if state == 'timed_out' else 125
        code = result.get('exit_code')
        return code if isinstance(code, int) and 0 <= code <= 124 else 125
    except (BridgeError, OSError, ValueError, TypeError, KeyError) as error:
        code = str(error) if isinstance(error, BridgeError) else 'private_configuration_or_bridge_failure'
        sys.stderr.write(json.dumps({'bridge_error': code, 'job_id': job_id,
                                     'idempotency_key': key, 'host_state': 'unknown',
                                     'host_termination_confirmed': False,
                                     'do_not_replay_mutating_operation': True}) + '\n')
        return 125
    finally:
        if job_id and not completed:
            try:
                request(config, 'DELETE', '/v1/opencli/jobs/' + job_id)
            except Exception:
                pass


if __name__ == '__main__':
    raise SystemExit(invoke(sys.argv[1:]))
