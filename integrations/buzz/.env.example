# Copy this file to .env and replace the placeholder with the dedicated Agent
# identity's key. Do not use the owner's personal Buzz key. The derived public
# key must match buzz.agent_pubkey in adapter.toml.
# Never commit or share the real value.
BUZZ_PRIVATE_KEY=nsec1_replace_with_a_new_private_key

# Optional NIP-OA owner attestation. Leave unset when it is not required.
# BUZZ_AUTH_TAG=["auth","<owner-pubkey>","<conditions>","<signature>"]
